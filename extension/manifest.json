{
  "manifest_version": 3,
  "name": "XGrab",
  "version": "1.0.0",
  "description": "Bouton de téléchargement XGrab sur les vidéos, comme Internet Download Manager.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "XGrab"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "xgrab@local",
      "strict_min_version": "121.0"
    }
  }
}
