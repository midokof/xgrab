[
  { "trigger": { "url-filter": ".*", "if-domain": [
      "*doubleclick.net", "*googlesyndication.com", "*googleadservices.com",
      "*google-analytics.com", "*googletagmanager.com", "*adservice.google",
      "*adnxs.com", "*rubiconproject.com", "*pubmatic.com", "*openx.net",
      "*criteo.com", "*criteo.net", "*taboola.com", "*outbrain.com"
    ] }, "action": { "type": "block" } },

  { "trigger": { "url-filter": ".*", "if-domain": [
      "*adroll.com", "*sharethrough.com", "*indexww.com", "*casalemedia.com",
      "*33across.com", "*smartadserver.com", "*teads.tv", "*imasdk.googleapis.com",
      "*adsystem.com", "*amazon-adsystem.com", "*yieldmo.com", "*zedo.com",
      "*popads.net", "*propellerads.com"
    ] }, "action": { "type": "block" } },

  { "trigger": { "url-filter": ".*", "if-domain": [
      "*mgid.com", "*adcash.com", "*exoclick.com", "*juicyads.com",
      "*hilltopads.net", "*adsterra.com", "*onclickalgo.com",
      "*poperblock.com", "*adskeeper.com", "*revcontent.com",
      "*adiquity.com", "*bidswitch.net", "*contextweb.com"
    ] }, "action": { "type": "block" } },

  { "trigger": { "url-filter": ".*", "if-domain": [
      "*gumgum.com", "*adform.net", "*districtm.io", "*mediance.com",
      "*media.net", "*sonobi.com", "*spotxchange.com", "*undertone.com",
      "*2mdn.net", "*adnxs.com", "*smaato.net", "*inmobi.com"
    ] }, "action": { "type": "block" } },

  { "trigger": {
      "url-filter": "^https?://[^/]+/(adserver|ads|adsbygoogle|advert|adframe|adhandler|pagead|popunder|clicktrack)([/?-]|$)"
    }, "action": { "type": "block" } },

  { "trigger": {
      "url-filter": "[?&](ad_?unit|adslot|adtype|ad_?zone|zone_?id)=[^&]*"
    }, "action": { "type": "block" } },

  { "trigger": { "url-filter": ".*", "resource-type": ["popup"] },
    "action": { "type": "block" } },

  { "trigger": { "url-filter": ".*", "resource-type": ["document"] },
    "action": { "type": "css-display-none",
      "selector": "iframe[id^=\"aswift_\"],iframe[src*=\"doubleclick\"],iframe[src*=\"googlesyndication\"],iframe[src*=\"2mdn\"]" } },

  { "trigger": { "url-filter": ".*", "resource-type": ["document"] },
    "action": { "type": "css-display-none",
      "selector": "[id^=\"div-gpt-ad\"],[id^=\"ad-slot\"],[id^=\"ad_\"],[id^=\"ad-\"],[id^=\"ads-\"],[id^=\"banner\"]" } },

  { "trigger": { "url-filter": ".*", "resource-type": ["document"] },
    "action": { "type": "css-display-none",
      "selector": "[id*=\"ad-container\"],[id*=\"ad-wrapper\"],[id*=\"adbanner\"],[id*=\"adbox\"],[id*=\"popunder\"],[id*=\"popup-overlay\"],[id*=\"modal-overlay\"]" } },

  { "trigger": { "url-filter": ".*", "resource-type": ["document"] },
    "action": { "type": "css-display-none",
      "selector": "[class^=\"ad-\"],[class^=\"ad_\"],[class^=\"ads-\"],[class^=\"ads_\"],[class^=\"advert\"]" } },

  { "trigger": { "url-filter": ".*", "resource-type": ["document"] },
    "action": { "type": "css-display-none",
      "selector": "[class*=\"ad-container\"],[class*=\"ad-wrapper\"],[class*=\"ad-slot\"],[class*=\"ad-placement\"],[class*=\"adsbygoogle\"]" } },

  { "trigger": { "url-filter": ".*", "resource-type": ["document"] },
    "action": { "type": "css-display-none",
      "selector": "[class*=\"banner-ad\"],[class*=\"popup-under\"],[class*=\"popunder\"],[class*=\"interstitial\"],[class*=\"sticky-footer\"],[class*=\"onload-modal\"],[class*=\"exit-intent\"]" } }
]